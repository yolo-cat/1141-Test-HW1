<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.deliveryplatform.gui.MainController">
   
   <!-- 頂部標題區域 -->
   <top>
      <VBox styleClass="header">
         <children>
            <HBox styleClass="title-bar" alignment="CENTER_LEFT">
               <children>
                  <Label styleClass="main-title" text="外賣平台異常演示系統" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="statusLabel" styleClass="status-label" text="系統就緒" />
               </children>
            </HBox>
            <ProgressBar fx:id="operationProgress" prefWidth="200.0" visible="false" />
         </children>
      </VBox>
   </top>

   <!-- 主要內容區域 - 左右分割布局 -->
   <center>
      <HBox spacing="0">
         <children>
            
            <!-- 左側：異常觸發控制區 -->
            <VBox styleClass="exception-demo-container" spacing="20" prefWidth="600" HBox.hgrow="ALWAYS">
               <children>
                  
                  <!-- 標題 -->
                  <Label styleClass="exception-title" text="異常觸發測試" />
                  
                  <!-- 異常說明 -->
                  <VBox spacing="10">
                     <children>
                        <Label styleClass="exception-description" text="點擊下方按鈕來觸發四種不同的自定義異常：" />
                        <Label styleClass="exception-description" text="• OrderValidationException - 訂單驗證錯誤" />
                        <Label styleClass="exception-description" text="• RestaurantUnavailableException - 餐廳不可用" />
                        <Label styleClass="exception-description" text="• InvalidOrderStateException - 無效狀態轉換" />
                        <Label styleClass="exception-description" text="• DeliveryAssignmentException - 配送分配失敗" />
                     </children>
                  </VBox>
                  
                  <!-- 異常觸發按鈕區域 -->
                  <VBox spacing="15" alignment="CENTER">
                     <children>
                        <!-- 第一行按鈕 -->
                        <HBox alignment="CENTER" spacing="15">
                           <children>
                              <Button fx:id="triggerValidationBtn" 
                                      styleClass="exception-btn-validation" 
                                      text="觸發訂單驗證異常" 
                                      prefWidth="250" prefHeight="70"
                                      onAction="#onTriggerValidationException">
                                 <font>
                                    <Font name="Impact" size="14.0" />
                                 </font>
                              </Button>
                              
                              <Button fx:id="triggerRestaurantBtn" 
                                      styleClass="exception-btn-restaurant" 
                                      text="觸發餐廳不可用異常" 
                                      prefWidth="250" prefHeight="70"
                                      onAction="#onTriggerRestaurantException">
                                 <font>
                                    <Font name="Impact" size="14.0" />
                                 </font>
                              </Button>
                           </children>
                        </HBox>
                        
                        <!-- 第二行按鈕 -->
                        <HBox alignment="CENTER" spacing="15">
                           <children>
                              <Button fx:id="triggerStateBtn" 
                                      styleClass="exception-btn-state" 
                                      text="觸發狀態轉換異常" 
                                      prefWidth="250" prefHeight="70"
                                      onAction="#onTriggerStateException">
                                 <font>
                                    <Font name="Impact" size="14.0" />
                                 </font>
                              </Button>
                              
                              <Button fx:id="triggerDeliveryBtn" 
                                      styleClass="exception-btn-delivery" 
                                      text="觸發配送分配異常" 
                                      prefWidth="250" prefHeight="70"
                                      onAction="#onTriggerDeliveryException">
                                 <font>
                                    <Font name="Impact" size="14.0" />
                                 </font>
                              </Button>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  
                  <!-- 控制按鈕 -->
                  <HBox alignment="CENTER" spacing="20">
                     <children>
                        <Button fx:id="clearLogBtn" 
                                styleClass="small-button" 
                                text="清除日誌" 
                                prefWidth="100"
                                onAction="#onClearLog" />
                        <Button fx:id="refreshLogBtn" 
                                styleClass="small-button" 
                                text="刷新日誌" 
                                prefWidth="100"
                                onAction="#onRefreshLog" />
                     </children>
                  </HBox>
                  
               </children>
            </VBox>

            <!-- 右側：系統日誌區域 -->
            <VBox styleClass="log-panel" prefWidth="500" minWidth="400">
               <children>
                  <HBox styleClass="log-header">
                     <children>
                        <Label styleClass="log-title" text="系統日誌" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label styleClass="log-title" text="實時輸出" />
                     </children>
                  </HBox>
                  <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS">
                     <content>
                        <TextArea fx:id="logDisplayArea" 
                                 styleClass="log-area" 
                                 editable="false" 
                                 wrapText="true" 
                                 prefRowCount="30" />
                     </content>
                  </ScrollPane>
               </children>
            </VBox>

         </children>
      </HBox>
   </center>

</BorderPane>
