<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.deliveryplatform.gui.MainController">
   <!-- 頂部標題區域 -->
   <top>
      <VBox styleClass="header">
         <children>
            <HBox styleClass="title-bar" alignment="CENTER_LEFT" spacing="20">
               <children>
                  <Label styleClass="main-title" text="異常處理演示系統" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="statusLabel" styleClass="status-label" text="系統就緒" />
               </children>
               <padding>
                  <Insets bottom="10" left="10" right="10" top="10" />
               </padding>
            </HBox>
         </children>
      </VBox>
   </top>

   <!-- 主要內容區域 -->
   <center>
      <HBox spacing="1">
         <children>
            
            <!-- 左側：異常觸發控制區 -->
            <VBox styleClass="content-panel" spacing="20" prefWidth="400" HBox.hgrow="ALWAYS">
               <children>
                  
                  <!-- 標題 -->
                  <Label styleClass="section-title" text="異常觸發器" />
                  
                  <!-- 異常觸發按鈕區域 -->
                  <VBox spacing="12">
                     <children>
                        <!-- 訂單驗證異常 -->
                        <VBox spacing="6" styleClass="panel">
                           <children>
                              <Label text="訂單驗證異常" styleClass="info-title" />
                              <Button fx:id="orderValidationExceptionBtn" 
                                      text="觸發驗證錯誤" 
                                      styleClass="exception-btn-validation"
                                      onAction="#onTriggerValidationException"
                                      maxWidth="Infinity" />
                              <Label text="模擬無效的訂單資料" styleClass="info-text" />
                           </children>
                        </VBox>
                        
                        <!-- 餐廳不可用異常 -->
                        <VBox spacing="6" styleClass="panel">
                           <children>
                              <Label text="餐廳不可用異常" styleClass="info-title" />
                              <Button fx:id="restaurantUnavailableExceptionBtn"
                                      text="觸發餐廳異常" 
                                      styleClass="exception-btn-restaurant"
                                      onAction="#onTriggerRestaurantException"
                                      maxWidth="Infinity" />
                              <Label text="模擬餐廳關閉或滿載" styleClass="info-text" />
                           </children>
                        </VBox>
                        
                        <!-- 無效狀態轉換異常 -->
                        <VBox spacing="6" styleClass="panel">
                           <children>
                              <Label text="無效狀態轉換異常" styleClass="info-title" />
                              <Button fx:id="invalidStateExceptionBtn"
                                      text="觸發狀態異常" 
                                      styleClass="exception-btn-state"
                                      onAction="#onTriggerStateException"
                                      maxWidth="Infinity" />
                              <Label text="模擬非法的訂單狀態變更" styleClass="info-text" />
                           </children>
                        </VBox>
                        
                        <!-- 配送分配異常 -->
                        <VBox spacing="6" styleClass="panel">
                           <children>
                              <Label text="配送分配異常" styleClass="info-title" />
                              <Button fx:id="deliveryAssignmentExceptionBtn"
                                      text="觸發配送異常" 
                                      styleClass="exception-btn-delivery"
                                      onAction="#onTriggerDeliveryException"
                                      maxWidth="Infinity" />
                              <Label text="模擬沒有可用配送員" styleClass="info-text" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>
                  
                  <!-- 控制按鈕 -->
                  <Separator />
                  <HBox spacing="10" alignment="CENTER">
                     <children>
                        <Button fx:id="createOrderBtn" 
                                text="建立測試訂單" 
                                styleClass="primary-button"
                                onAction="#onCreateOrder" />
                        <Button fx:id="clearLogBtn" 
                                text="清除日誌" 
                                styleClass="secondary-button"
                                onAction="#onClearLog" />
                     </children>
                  </HBox>
                  
               </children>
            </VBox>

            <!-- 右側：系統日誌區域 -->
            <VBox styleClass="content-panel" prefWidth="450" minWidth="400" HBox.hgrow="NEVER">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10">
                     <children>
                        <Label styleClass="section-title" text="系統日誌" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="refreshLogBtn" 
                                text="刷新" 
                                styleClass="small-button"
                                onAction="#onRefreshLog" />
                     </children>
                  </HBox>
                  
                  <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                     <content>
                        <TextArea fx:id="logDisplayArea" 
                                 styleClass="text-area" 
                                 editable="false" 
                                 wrapText="true"
                                 prefRowCount="25" />
                     </content>
                  </ScrollPane>
               </children>
            </VBox>

         </children>
      </HBox>
   </center>

</BorderPane>